          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "category": {
            "type": "string",
            "enum": [
              "absence",
              "clinic_respiratory",
              "clinic_gi",
              "first_aid_heat",
              "near_miss",
              "clinic_injury",
              "teleconsult"
            ],
            "title": "Category"
          },
          "count": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "unit",
          "date",
          "category",
          "count"
